<?php

namespace App\Http\Controllers;

use App\Models\AuditLog;
use App\Models\Product;
use App\Models\ProductionBatch;
use App\Services\StokService;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\Auth;
use Illuminate\Support\Facades\DB;
use Illuminate\Validation\ValidationException;

class ProduksiController extends Controller
{
    public function index(StokService $stok)
    {
        $user = Auth::user();
        // Kasir tidak boleh melihat data ayam hidup (jumlah masuk, berat, rendemen)
        $lihatAyam = ! $user->isKasir();

        $batches = ProductionBatch::with(['createdBy:id,name', 'weighingRecords.product:id,name'])
            ->when(! $lihatAyam, fn ($q) => $q->where('status', 'COMPLETED'))
            ->orderByDesc('production_date')->orderByDesc('created_at')
            ->limit(30)->get();

        $menunggu = ProductionBatch::where('status', 'PLANNED')
            ->orderBy('production_date')->orderBy('created_at')
            ->get(['id', 'batch_number', 'production_date'])
            ->map(fn ($b) => ['id' => $b->id, 'label' => $b->batch_number . ' · ' . $b->production_date->format('d/m/Y')])
            ->values();

        $produk = Product::where('is_active', true)->where('is_live_bird', false)
            ->orderBy('name')->get(['id', 'name']);

        return view('produksi.index', [
            'batches'    => $batches,
            'menunggu'   => $menunggu,
            'lihatAyam'  => $lihatAyam,
            'stok'       => $lihatAyam ? $stok->ayamHidup() : null,
            'produkOpsi' => $produk->map(fn ($p) => ['id' => $p->id, 'name' => $p->name])->values(),
            'bolehTulis' => $user->canWrite('produksi_input'),
        ]);
    }

    public function store(Request $request, StokService $stok)
    {
        abort_unless(Auth::user()->canWrite('produksi_input'), 403);

        $data = $request->validate([
            'batch_id'           => ['required', 'uuid', 'exists:production_batches,id'],
            'items'              => ['required', 'array', 'min:1'],
            'items.*.product_id' => ['required', 'uuid', 'exists:products,id'],
            'items.*.weight_kg'  => ['required', 'numeric', 'min:0.01', 'max:1000000'],
        ]);

        $ids = collect($data['items'])->pluck('product_id')->unique()->all();
        $valid = Product::whereIn('id', $ids)->where('is_active', true)->where('is_live_bird', false)->count();
        if ($valid !== count($ids)) {
            throw ValidationException::withMessages([
                'items' => 'Ada produk yang tidak valid atau tidak aktif. Muat ulang halaman.',
            ]);
        }

        $hasilKg = round((float) collect($data['items'])->sum(fn ($r) => (float) $r['weight_kg']), 2);

        $batch = DB::transaction(function () use ($data, $stok, $hasilKg) {
            $batch = ProductionBatch::lockForUpdate()->findOrFail($data['batch_id']);

            if ($batch->status !== 'PLANNED') {
                throw ValidationException::withMessages(['batch_id' => 'Batch ini sudah diisi hasilnya.']);
            }
            // Pesan sengaja tanpa angka supaya berat ayam tidak terbaca Kasir
            if ($hasilKg > (float) $batch->input_weight_kg) {
                throw ValidationException::withMessages([
                    'items' => 'Total hasil melebihi berat ayam yang diserahkan ke produksi. Periksa kembali timbangan.',
                ]);
            }

            $ymd = $batch->production_date->format('Ymd');
            $stok->kunci('produksi_number_' . $ymd);

            $rp = 'WR-' . $ymd . '-';
            $akhir = \App\Models\WeighingRecord::where('receipt_number', 'like', $rp . '%')->max('receipt_number');
            $no = $akhir ? ((int) substr($akhir, strlen($rp))) : 0;

            foreach ($data['items'] as $row) {
                $no++;
                $batch->weighingRecords()->create([
                    'receipt_number' => $rp . str_pad((string) $no, 4, '0', STR_PAD_LEFT),
                    'product_id'     => $row['product_id'],
                    'weight_kg'      => round((float) $row['weight_kg'], 2),
                    'operator_id'    => Auth::id(),
                ]);
            }

            $batch->update(['status' => 'COMPLETED']);

            AuditLog::create([
                'action'     => 'CREATE',
                'table_name' => 'weighing_records',
                'record_id'  => $batch->id,
                'new_values' => ['batch_number' => $batch->batch_number, 'items' => $data['items'], 'hasil_kg' => $hasilKg],
                'user_id'    => Auth::id(),
            ]);

            return $batch;
        });

        $pesan = 'Hasil produksi tersimpan untuk ' . $batch->batch_number . '.';
        if (! Auth::user()->isKasir() && (float) $batch->input_weight_kg > 0) {
            $pesan .= ' Rendemen ' . number_format($hasilKg / (float) $batch->input_weight_kg * 100, 1, ',', '.') . '%.';
        }

        return redirect()->route('produksi.index')->with('status', $pesan);
    }
}