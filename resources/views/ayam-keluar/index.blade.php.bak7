    $ekor = fn ($n) => number_format((float) $n, 0, ',', '.');
    $kg   = fn ($n) => number_format((float) $n, 2, ',', '.');
    $tgl  = fn ($d) => \Illuminate\Support\Carbon::parse($d)->format('d/m/Y');
@endphp

