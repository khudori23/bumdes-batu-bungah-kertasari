                    <td class="right" data-label="Ekor">{{ $ekor($j->quantity) }}</td>
                    <td class="right" data-label="Berat (kg)">{{ $j->weight_kg !== null ? $kg($j->weight_kg) : '-' }}</td>
                </tr>
