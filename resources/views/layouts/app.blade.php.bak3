        $aktif = function (array $i): bool {
            $a = request()->routeIs(...$i['on']);
            if ($a && ! empty($i['not']) && request()->routeIs(...$i['not'])) {
                $a = false;
            }
            return $a;
        };
    @endphp

    <aside class="sb" id="sb" aria-label="Menu utama">
